// ReadySet database schema (Day 2: users + preferences only).
// Event, checklist and notification models are added in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Used ONLY by `prisma migrate dev` (scratch database that Prisma resets). Must be readyset_isolated_shadow.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                        String           @id @default(uuid()) @db.Uuid
  name                      String           @db.VarChar(100)
  email                     String           @unique @db.VarChar(254)
  passwordHash              String           @map("password_hash")
  // Bumped on logout; tokens carry the version they were issued with, so old ones stop working.
  tokenVersion              Int              @default(0) @map("token_version")
  // NULL = not verified. Existing users are deliberately NOT marked verified by the migration.
  emailVerifiedAt           DateTime?        @map("email_verified_at")
  // Set only for accounts created while EMAIL_VERIFICATION_REQUIRED=true; existing users stay false (never locked out).
  emailVerificationRequired Boolean          @default(false) @map("email_verification_required")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")
  preference                UserPreference?
  events                    Event[]
  recurrenceRules           RecurrenceRule[]
  authTokens                AuthToken[]
  emailLogs                 EmailLog[]
  checklistItems            ChecklistItem[]
  notifications             Notification[]
  eventExceptions           EventException[]
  eventTemplates            EventTemplate[]
  packingTemplates          PackingTemplate[]
  forgottenReports          ForgottenItemReport[]
  savedPlaces               SavedPlace[]
  preparationLogs           PreparationLog[]

  @@map("users")
}

model UserPreference {
  id                          String   @id @default(uuid()) @db.Uuid
  userId                      String   @unique @map("user_id") @db.Uuid
  defaultPreparationMinutes   Int      @default(30) @map("default_preparation_minutes")
  defaultArrivalBufferMinutes Int      @default(10) @map("default_arrival_buffer_minutes")
  preferredTravelMode         String   @default("manual") @map("preferred_travel_mode") @db.VarChar(20)
  timezone                    String   @default("Asia/Dhaka") @db.VarChar(64)
  // Email reminder opt-ins (security / verification / password-reset emails can never be disabled).
  emailUpcomingReminders      Boolean  @default(false) @map("email_upcoming_reminders")
  emailPrepReminders          Boolean  @default(false) @map("email_prep_reminders")
  emailDepartureReminders     Boolean  @default(false) @map("email_departure_reminders")
  // In-app notifications (generated by the notification sweep from the departure engine's times).
  notificationsEnabled        Boolean  @default(true) @map("notifications_enabled")
  notifyUpcoming              Boolean  @default(true) @map("notify_upcoming")
  notifyPrep                  Boolean  @default(true) @map("notify_prep")
  notifyDeparture             Boolean  @default(true) @map("notify_departure")
  notifyChecklist             Boolean  @default(true) @map("notify_checklist")
  // "Approaching" reminders fire this many minutes before preparation start / departure.
  notificationLeadMinutes     Int      @default(10) @map("notification_lead_minutes")
  // The user's opt-in to browser (Web Notifications) alerts; the browser permission itself lives in the browser.
  browserNotificationsEnabled Boolean  @default(false) @map("browser_notifications_enabled")
  // The user's default starting location (one per user by construction). Cleared automatically if that place is deleted.
  defaultStartPlaceId         String?  @map("default_start_place_id") @db.Uuid
  // Adaptive preparation profile: the user can switch it off, and keep their own per-category values ({category: {prepMinutes, bufferMinutes}}).
  adaptiveProfileEnabled      Boolean  @default(true) @map("adaptive_profile_enabled")
  preparationOverrides        Json?    @map("preparation_overrides")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  // Deleting a user removes their preference row (no orphans).
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultStartPlace SavedPlace? @relation("DefaultStartPlace", fields: [defaultStartPlaceId], references: [id], onDelete: SetNull)

  @@map("user_preferences")
}

// Recurrence is stored as a RULE, never as generated rows. Occurrences are calculated on demand
// for a requested date range (see src/services/recurrence.service.js).
model RecurrenceRule {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  frequency  String    @db.VarChar(10) // DAILY | WEEKLY
  interval   Int       @default(1)
  daysOfWeek Int[]     @map("days_of_week") // ISO weekdays 1=Mon..7=Sun (WEEKLY only)
  occurrenceCount Int?  @map("occurrence_count") // set when the series ends after N occurrences (endsAt is then derived from it)
  endsAt     DateTime? @map("ends_at") // last instant (end of the chosen local day) a series may produce occurrences
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Owned by the user too, so deleting a user cascades and can never leave orphan rules.
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event?

  @@map("recurrence_rules")
}

model Event {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  title                 String   @db.VarChar(150)
  category              String   @db.VarChar(20)
  startAt               DateTime @map("start_at") // absolute UTC instant of the first occurrence
  timezone              String   @db.VarChar(64) // IANA zone the user meant the local time in
  destination           String?  @db.VarChar(255)
  notes                 String?  @db.VarChar(2000)
  travelDurationMinutes Int      @map("travel_duration_minutes")
  preparationMinutes    Int      @map("preparation_minutes")
  arrivalBufferMinutes  Int      @map("arrival_buffer_minutes")
  // NULL = unknown. The conflict detector then ASSUMES 60 minutes and says so.
  durationMinutes       Int?     @map("duration_minutes")
  // low | normal | high: how much the user cares about this event (shown in the weekly planner and used for conflict emphasis).
  priority              String   @default("normal") @db.VarChar(8)
  isRecurring           Boolean  @default(false) @map("is_recurring")
  recurrenceRuleId      String?  @unique @map("recurrence_rule_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrenceRule RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)
  checklistItems ChecklistItem[]
  notifications  Notification[]
  exceptions     EventException[]
  forgottenReports ForgottenItemReport[]
  preparationLogs  PreparationLog[]

  @@index([userId, startAt])
  @@index([userId, category])
  @@map("events")
}

// One table for every emailed single-use token. Only the SHA-256 HASH of the token is stored;
// the plaintext exists only in the email link.
model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(20) // EMAIL_VERIFY | PASSWORD_RESET | EMAIL_CHANGE
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  newEmail  String?   @map("new_email") @db.VarChar(254) // EMAIL_CHANGE only
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// Audit trail of email attempts. Never contains passwords, tokens or reset/verification URLs.
// ACCEPTED means the provider accepted the message, NOT that it reached an inbox.
model EmailLog {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  emailType         String   @map("email_type") @db.VarChar(40)
  recipient         String   @db.VarChar(254)
  provider          String   @db.VarChar(20)
  providerMessageId String?  @map("provider_message_id") @db.VarChar(100)
  status            String   @db.VarChar(12) // PENDING | RETRYING | ACCEPTED | FAILED
  attempts          Int      @default(0)
  errorCode         String?  @map("error_code") @db.VarChar(60)
  dedupeKey         String?  @unique @map("dedupe_key") @db.VarChar(200)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, emailType])
  @@map("email_logs")
}

// One checklist per event (a recurring series shares one checklist). Owned by the user AND the event:
// deleting either removes the items (no orphans). Every query also filters by userId (IDOR protection).
model ChecklistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  text      String   @db.VarChar(120)
  group     String   @default("Essentials") @map("item_group") @db.VarChar(20)
  done      Boolean  @default(false)
  // When it was last ticked (cleared when unticked). Items ticked before this column existed have no time.
  completedAt DateTime? @map("completed_at")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
  @@index([userId, eventId])
  @@map("checklist_items")
}

// In-app notification. Created ONLY by the notification sweep (src/services/notificationSweep.service.js).
// dedupeKey (user + event + occurrence instant + kind) is UNIQUE, so the same reminder can never be inserted
// twice, even if two sweeps run at once. Deleting the event or the user deletes its notifications.
model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  eventId         String?   @map("event_id") @db.Uuid
  type            String    @db.VarChar(30) // UPCOMING | PREP_SOON | PREP_NOW | DEPARTURE_SOON | DEPARTURE_NOW | CHECKLIST
  category        String    @db.VarChar(12) // departure | preparation | event | system (drives the icon / filter)
  title           String    @db.VarChar(150)
  body            String    @db.VarChar(400)
  occurrenceStart DateTime? @map("occurrence_start")
  dedupeKey       String    @unique @map("dedupe_key") @db.VarChar(200)
  readAt          DateTime? @map("read_at")
  // Snooze: while snoozedUntil is in the future the notification is hidden from the unread list/count; it stays in history.
  snoozedUntil    DateTime? @map("snoozed_until")
  createdAt       DateTime  @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, snoozedUntil])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([eventId])
  @@map("notifications")
}

// One row per modified or skipped OCCURRENCE of a recurring event (the series itself is never copied).
// (eventId, originalStart) is UNIQUE, so skipping/editing the same occurrence twice updates one row.
model EventException {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  eventId               String   @map("event_id") @db.Uuid
  originalStart         DateTime @map("original_start") // the generated occurrence this refers to
  kind                  String   @db.VarChar(10) // SKIPPED | OVERRIDDEN
  title                 String?  @db.VarChar(150)
  destination           String?  @db.VarChar(255)
  notes                 String?  @db.VarChar(2000)
  startAt               DateTime? @map("start_at")
  travelDurationMinutes Int?     @map("travel_duration_minutes")
  preparationMinutes    Int?     @map("preparation_minutes")
  arrivalBufferMinutes  Int?     @map("arrival_buffer_minutes")
  durationMinutes       Int?     @map("duration_minutes")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalStart])
  @@index([userId, eventId])
  @@map("event_exceptions")
}

// A reusable starting point for new events (no date: the date is chosen when the template is used).
model EventTemplate {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  name                  String   @db.VarChar(80)
  title                 String   @db.VarChar(150)
  category              String   @db.VarChar(20)
  destination           String?  @db.VarChar(255)
  notes                 String?  @db.VarChar(2000)
  timezone              String?  @db.VarChar(64)
  travelDurationMinutes Int      @map("travel_duration_minutes")
  preparationMinutes    Int      @map("preparation_minutes")
  arrivalBufferMinutes  Int      @map("arrival_buffer_minutes")
  durationMinutes       Int?     @map("duration_minutes")
  recurrence            Json?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("event_templates")
}

// A user's own named packing list (e.g. "Gym bag"). Items are validated by the service (max 100, each {text, group}).
model PackingTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(80)
  items     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("packing_templates")
}

// "I forgot this" reports: created ONLY when the user explicitly says so. An unchecked item is never counted.
// One report per user + event + item + day (idempotent). Kept (event_id set to NULL) if the event is deleted.
model ForgottenItemReport {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  eventId    String?  @map("event_id") @db.Uuid
  itemText   String   @map("item_text") @db.VarChar(120)
  textKey    String   @map("text_key") @db.VarChar(120) // lower-case, whitespace-collapsed itemText
  reportedOn DateTime @map("reported_on") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([userId, eventId, textKey, reportedOn])
  @@index([userId, textKey])
  @@map("forgotten_item_reports")
}

// A named place the user reuses (home, office, university...). Private: only ever read/written with the owner's id.
model SavedPlace {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String   @db.VarChar(60)
  kind      String   @db.VarChar(12) // home | office | university | other
  address   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedAsStart UserPreference[] @relation("DefaultStartPlace")

  @@unique([userId, label])
  @@index([userId])
  @@map("saved_places")
}

// One row per occurrence the user chose to log ("Start preparing" / "I'm ready" / "I left"). ALL timestamps are written by
// the server. Nothing here is inferred from checklist activity. Rows are kept (event_id -> NULL) if the event is deleted.
// NOTE: PostgreSQL treats NULLs as distinct in a unique index, so after an event is deleted its logs (event_id NULL) no longer
// collide with each other. That is safe because logs can only be created for an EXISTING event (the API 404s otherwise).
model PreparationLog {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  eventId             String?   @map("event_id") @db.Uuid
  occurrenceStart     DateTime  @map("occurrence_start")
  category            String    @db.VarChar(20)
  plannedPrepMinutes  Int       @map("planned_prep_minutes")
  plannedDepartureAt  DateTime  @map("planned_departure_at")
  prepStartedAt       DateTime? @map("prep_started_at")
  readyAt             DateTime? @map("ready_at")
  cancelledAt         DateTime? @map("cancelled_at")
  leftAt              DateTime? @map("left_at")
  uncheckedItems      Json?     @map("unchecked_items") // names of the user's own checklist items still unchecked when they pressed "I left" (max 20)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([userId, eventId, occurrenceStart])
  @@index([userId, occurrenceStart(sort: Desc)])
  @@map("preparation_logs")
}
