// ReadySet database schema (Day 2: users + preferences only).
// Event, checklist and notification models are added in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Used ONLY by `prisma migrate dev` (scratch database that Prisma resets). Must be readyset_isolated_shadow.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                        String           @id @default(uuid()) @db.Uuid
  name                      String           @db.VarChar(100)
  email                     String           @unique @db.VarChar(254)
  passwordHash              String           @map("password_hash")
  // Bumped on logout; tokens carry the version they were issued with, so old ones stop working.
  tokenVersion              Int              @default(0) @map("token_version")
  // NULL = not verified. Existing users are deliberately NOT marked verified by the migration.
  emailVerifiedAt           DateTime?        @map("email_verified_at")
  // Set only for accounts created while EMAIL_VERIFICATION_REQUIRED=true; existing users stay false (never locked out).
  emailVerificationRequired Boolean          @default(false) @map("email_verification_required")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")
  preference                UserPreference?
  events                    Event[]
  recurrenceRules           RecurrenceRule[]
  authTokens                AuthToken[]
  emailLogs                 EmailLog[]

  @@map("users")
}

model UserPreference {
  id                          String   @id @default(uuid()) @db.Uuid
  userId                      String   @unique @map("user_id") @db.Uuid
  defaultPreparationMinutes   Int      @default(30) @map("default_preparation_minutes")
  defaultArrivalBufferMinutes Int      @default(10) @map("default_arrival_buffer_minutes")
  preferredTravelMode         String   @default("manual") @map("preferred_travel_mode") @db.VarChar(20)
  timezone                    String   @default("Asia/Dhaka") @db.VarChar(64)
  // Email reminder opt-ins (security / verification / password-reset emails can never be disabled).
  emailUpcomingReminders      Boolean  @default(false) @map("email_upcoming_reminders")
  emailPrepReminders          Boolean  @default(false) @map("email_prep_reminders")
  emailDepartureReminders     Boolean  @default(false) @map("email_departure_reminders")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  // Deleting a user removes their preference row (no orphans).
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Recurrence is stored as a RULE, never as generated rows. Occurrences are calculated on demand
// for a requested date range (see src/services/recurrence.service.js).
model RecurrenceRule {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  frequency  String    @db.VarChar(10) // DAILY | WEEKLY
  interval   Int       @default(1)
  daysOfWeek Int[]     @map("days_of_week") // ISO weekdays 1=Mon..7=Sun (WEEKLY only)
  endsAt     DateTime? @map("ends_at") // last instant (end of the chosen local day) a series may produce occurrences
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Owned by the user too, so deleting a user cascades and can never leave orphan rules.
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event?

  @@map("recurrence_rules")
}

model Event {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  title                 String   @db.VarChar(150)
  category              String   @db.VarChar(20)
  startAt               DateTime @map("start_at") // absolute UTC instant of the first occurrence
  timezone              String   @db.VarChar(64) // IANA zone the user meant the local time in
  destination           String?  @db.VarChar(255)
  notes                 String?  @db.VarChar(2000)
  travelDurationMinutes Int      @map("travel_duration_minutes")
  preparationMinutes    Int      @map("preparation_minutes")
  arrivalBufferMinutes  Int      @map("arrival_buffer_minutes")
  isRecurring           Boolean  @default(false) @map("is_recurring")
  recurrenceRuleId      String?  @unique @map("recurrence_rule_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrenceRule RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id], onDelete: SetNull)

  @@index([userId, startAt])
  @@index([userId, category])
  @@map("events")
}

// One table for every emailed single-use token. Only the SHA-256 HASH of the token is stored;
// the plaintext exists only in the email link.
model AuthToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(20) // EMAIL_VERIFY | PASSWORD_RESET | EMAIL_CHANGE
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  newEmail  String?   @map("new_email") @db.VarChar(254) // EMAIL_CHANGE only
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

// Audit trail of email attempts. Never contains passwords, tokens or reset/verification URLs.
// ACCEPTED means the provider accepted the message, NOT that it reached an inbox.
model EmailLog {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String?  @map("user_id") @db.Uuid
  emailType         String   @map("email_type") @db.VarChar(40)
  recipient         String   @db.VarChar(254)
  provider          String   @db.VarChar(20)
  providerMessageId String?  @map("provider_message_id") @db.VarChar(100)
  status            String   @db.VarChar(12) // PENDING | RETRYING | ACCEPTED | FAILED
  attempts          Int      @default(0)
  errorCode         String?  @map("error_code") @db.VarChar(60)
  dedupeKey         String?  @unique @map("dedupe_key") @db.VarChar(200)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, emailType])
  @@map("email_logs")
}
