{
  "name": "readyset-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/prisma-safe.mjs dev",
    "db:setup": "node scripts/setup-local-db.mjs",
    "db:deploy": "node scripts/prisma-safe.mjs deploy",
    "db:migrate:test": "node scripts/prisma-safe.mjs deploy --test",
    "db:validate": "prisma validate",
    "test": "node scripts/run-tests.mjs",
    "test:raw": "vitest run",
    "test:pure": "vitest run --config vitest.pure.config.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "resend": "^6.38.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
