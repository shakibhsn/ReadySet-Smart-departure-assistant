# Copy this file to .env (never commit .env) and fill in real values.
# Use a DEDICATED ReadySet database, never a database that belongs to another project.
DATABASE_URL=postgresql://readyset_isolated_app:CHANGE_ME@localhost:5432/readyset_isolated_dev?schema=public
# DEVELOPMENT ONLY. Used by `prisma migrate dev` alone; not read by the API. Never set it in production/deployment config (the API refuses to start with it in production). Must be exactly readyset_isolated_shadow on the same server.
SHADOW_DATABASE_URL=postgresql://readyset_isolated_app:CHANGE_ME@localhost:5432/readyset_isolated_shadow?schema=public
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
PORT=5174
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Optional (default 12). Higher is slower and stronger.
# BCRYPT_ROUNDS=12

# ---- Email (see README "Email system") ----
# console = print a preview, send nothing (safe for development). provider = really send.
# production REQUIRES provider.
EMAIL_MODE=console
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# A sender address on a domain you verified in Resend, e.g. no-reply@mail.yourdomain.com
EMAIL_FROM=
EMAIL_FROM_NAME=ReadySet
# Frontend base URL used for links inside emails (defaults to FRONTEND_URL)
APP_BASE_URL=http://localhost:5173
# Shown in email footers (optional)
SUPPORT_EMAIL=
# false = existing behaviour. true = NEW accounts must verify their email before they can log in.
EMAIL_VERIFICATION_REQUIRED=false
# true = send event / preparation / departure reminders to users who opted in
EMAIL_REMINDERS_ENABLED=false

# ---- Weather & Explore (optional) ----
# Overpass API for nearby places (OpenStreetMap). One URL or several separated by commas (tried in order).
# The free public servers are shared and sometimes slow: for real traffic run your own Overpass instance and set it here.
OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# ---- AI Departure Assistant (optional) ----
# Uses OpenRouter. Leave the key empty to use the built-in rules-based answers. Never commit a real key.
# Only the question, event titles/destinations and the server-built draft answer are sent; event notes never are.
OPENROUTER_API_KEY=
ASSISTANT_MODEL=openai/gpt-5.2
