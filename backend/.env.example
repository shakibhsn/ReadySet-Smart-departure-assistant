# Copy this file to .env (never commit .env) and fill in real values.
# Use a DEDICATED ReadySet database, never a database that belongs to another project.
DATABASE_URL=postgresql://readyset_app:YOUR_PASSWORD@localhost:5432/readyset_dev?schema=public
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
PORT=5174
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Optional (default 12). Higher is slower and stronger.
# BCRYPT_ROUNDS=12

# ---- Email (see README "Email system") ----
# console = print a preview, send nothing (safe for development). provider = really send.
# production REQUIRES provider.
EMAIL_MODE=console
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# A sender address on a domain you verified in Resend, e.g. no-reply@mail.yourdomain.com
EMAIL_FROM=
EMAIL_FROM_NAME=ReadySet
# Frontend base URL used for links inside emails (defaults to FRONTEND_URL)
APP_BASE_URL=http://localhost:5173
# Shown in email footers (optional)
SUPPORT_EMAIL=
# false = existing behaviour. true = NEW accounts must verify their email before they can log in.
EMAIL_VERIFICATION_REQUIRED=false
# true = send event / preparation / departure reminders to users who opted in
EMAIL_REMINDERS_ENABLED=false
