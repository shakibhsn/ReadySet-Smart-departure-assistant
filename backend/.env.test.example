# Copy to .env.test. Tests DELETE rows, so the database name MUST end with "_test"
# (the backend refuses to run tests otherwise).
DATABASE_URL=postgresql://readyset_app:YOUR_PASSWORD@localhost:5432/readyset_test?schema=public
JWT_SECRET=test-only-secret-at-least-32-characters-long-0000
JWT_EXPIRES_IN=1d
PORT=4001
FRONTEND_URL=http://localhost:5173
NODE_ENV=test
BCRYPT_ROUNDS=4
