# Frontend (Vite) configuration. Copy to .env.local. Only VITE_* values are exposed to the browser,
# so NEVER put secrets here.
VITE_API_BASE_URL=http://localhost:5174/api

# Optional: an OpenStreetMap-compatible tile URL for the Explore map (default: the public OSM server, light use only).
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
